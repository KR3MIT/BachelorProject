--- !u!1001 &77400260734272360
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 8739091431888419500}
    m_Modifications:
    - target: {fileID: 2892839821128672011, guid: d9c02f6dad651a149a752edfaf9c893d, type: 3}
      propertyPath: m_text
      value: "Liberalisternes Parti er st\xE6rkt pr\xE6get af teorien om Liberalisme
        i International Politik. \n\nPartiet ser stigende global interdependens som
        positivt for verdens lande, og mener at en udbredelse af demokratiet og f\xE6lles
        normer og interesser kan holde verdensfreden p\xE5 lang sigt.\n\nLP\u2019s
        verdenssyn antager, at stater er styret af politiske processer, og at staterne
        derfor p\xE5 lang sigt kan se udover det objektive internationale magtspil,
        og derved skabe en samarbejdende verden. \n\nLP ser ikke stater som eneakt\xF8rer,
        og betragter b\xE5de internationale og nationale institutioner som vigtige
        i det politiske landskab."
      objectReference: {fileID: 0}
    - target: {fileID: 2892839821128672011, guid: d9c02f6dad651a149a752edfaf9c893d, type: 3}
      propertyPath: m_fontSize
      value: 12
      objectReference: {fileID: 0}
