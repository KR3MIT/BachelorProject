--- !u!1001 &9211038817533518439
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1013585593827995669}
    m_Modifications:
    - target: {fileID: 2892839821128672011, guid: d9c02f6dad651a149a752edfaf9c893d, type: 3}
      propertyPath: m_text
      value: "Realisternes Parti er st\xE6rkt pr\xE6get af teorien om Realisme i
        International Politik.\n\nI en usikker verden pr\xE6get af anarki p\xE5 den
        globale scene, ser RP stor n\xF8dvendighed i at beskytte Danmarks nationale
        interesser.\n\nFor RP er stater eneakt\xF8rer i det politiske landskab, og
        disse stater vil agere efter objektive forhold for at styrke egen magt og
        interesser.\n\nP\xE5 den globale scene er magt altafg\xF8rende i RP\u2019s
        \xF8jne, og fred varer kun s\xE5 l\xE6nge der findes en magtbalance i verden."
      objectReference: {fileID: 0}
    - target: {fileID: 2892839821128672011, guid: d9c02f6dad651a149a752edfaf9c893d, type: 3}
