%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e66537972dc00a64b8d009f7c8362fc7, type: 3}
  m_Name: TooltipExample
  m_EditorClassIdentifier: Assembly-CSharp::TooltipDefinition
  entries:
  - keyword: Interdependens
    definition: "Interdependens er et fremmedord for gensidig afh\xE6ngig. I International
      Politik hentyder det til, at stater og samfund er v\xE6vet sammen og afh\xE6ngige
      af hinanden."
    image: {fileID: 0}
  - keyword: Anarki
    definition: "Anarki opst\xE5r, n\xE5r der er mangel p\xE5 f\xE6lles spilleregler
      eller overordnet myndighed. Anarki kan derved bruges til at beskrive internationale
      relationer, hvor ingen myndighed findes over stater."
    image: {fileID: 21300000, guid: 19e9460c335776a49868ba19454a645a, type: 3}
  - keyword: Teori
    definition: "I International Politik bruges teorier som et grundlag for fortolkning
      af globale begivenheder. Teorier bruges alts\xE5 til at forklare observationer,
      men ikke til at planl\xE6gge fremtidige m\xE5ls\xE6tninger eller aktioner."
    image: {fileID: 21300000, guid: d0f1962df78d4754d9c5a3a527144870, type: 3}
  - keyword: Ideologi
    definition: "I International Politik bruges ideologier til at guide ops\xE6tningen
      af m\xE5ls\xE6tninger for et parti eller en regering. Ideologier f\xE5r ofte
      deres grundlag fra et verdenssyn dannet p\xE5 baggrund af teorier, og disse
      h\xE6nger derfor ofte, men ikke altid, sammen."
    image: {fileID: 21300000, guid: d0f1962df78d4754d9c5a3a527144870, type: 3}
  - keyword: Traktat
    definition: En traktat er en folkeretligt bindende, skriftlig aftale mellem to
      eller flere stater eller internationale organisationer.
    image: {fileID: 0}
  - keyword: NATO
    definition: "NATO (North Atlantic Treaty Organization) er\_verdens st\xF8rste
      forsvarsalliance, oprettet i 1949 for at sikre medlemslandenes frihed og sikkerhed
      gennem politisk og milit\xE6rt samarbejde. 32 lande er medlem af NATO, inklusiv
      Danmark samt en stor del af de europ\xE6iske lande, USA og Canada."
    image: {fileID: 21300000, guid: 092b7d6cde6248741ac28add0983f58b, type: 3}
  - keyword: EU
    definition: "Den Europ\xE6iske Union (EU) er\_et politisk og \xF8konomisk f\xE6llesskab
      mellem 27 europ\xE6iske lande. Form\xE5let med EU er at sikre \xF8konomisk
      velstand, stabilitet og sikkerhed i hele Europa."
    image: {fileID: 21300000, guid: 95c0d12c50fb2bf40a01f1463aae727e, type: 3}
  - keyword: Alliance
    definition: "En alliance i international politik er en formel aftale mellem to
      eller flere stater om samarbejde, typisk med fokus p\xE5 forsvar og sikkerhed."
    image: {fileID: 0}
  - keyword: LP
    definition: "Liberalisternes Parti, et parti der ideologisk er st\xE6rkt pr\xE6get
      af teorien om liberalisme fra International Politik."
    image: {fileID: 0}
  - keyword: RP
    definition: "Realisternes Parti, et parti der ideologisk er st\xE6rkt pr\xE6get
      af teorien om realisme fra International Politik."
    image: {fileID: 0}
  - keyword: Magt
    definition: "I International Politik er magt et stort tema, og magtens form kan
      variere meget. Dette inkluderer f.eks. milit\xE6r magt, men ogs\xE5 mere indirekte
      magtformer som kulturel magt eller kontrol af produktionssektorer."
    image: {fileID: 21300000, guid: 5d68dad9083c4014fbef1f38856ed566, type: 3}
  - keyword: "Konfliktbil\xE6ggelse"
    definition: "Konfliktbil\xE6ggelse betyder at afslutte, l\xF8se eller d\xE6mpe
      en uoverensstemmelse eller konflikt mellem to eller flere parter."
    image: {fileID: 0}
  - keyword: Traktater
    definition: En traktat er en folkeretligt bindende, skriftlig aftale mellem to
      eller flere stater eller internationale organisationer.
    image: {fileID: 0}
  - keyword: beskrivelsen
    definition: "Her st\xE5r en forklaring af ordet."
    image: {fileID: 0}
