--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 71e680697196b9e408469a3706900ca3, type: 3}
  m_Name: TutorialQuestionStepExample
  m_EditorClassIdentifier: Assembly-CSharp::TutorialQuestionStep
  question: "Her st\xE5r beskrivelsen af scenariet."
  answers:
  - answerText: "Her st\xE5r et andet svar"
    viewpoint: 0
    explanations:
    - explanationText: "Her st\xE5r statsministerens reaktion"
      viewpoint: 0
      image: {fileID: 0}
    - explanationText: "Her st\xE5r statsministerens reaktion"
      viewpoint: 1
      image: {fileID: 0}
  - answerText: "Her st\xE5r et svar"
    viewpoint: 1
    explanations:
    - explanationText: "Her st\xE5r statsministerens reaktion"
      viewpoint: 0
      image: {fileID: 0}
    - explanationText: "Her st\xE5r statsministerens reaktion"
      viewpoint: 1
      image: {fileID: 0}
  tutorialSteps:
  - position: {x: 0, y: 0}
    tutorialText: "I er blevet udpeget som medministre i en ny regering, og skal
      nu varetage Danmarks udenrigspolitik sammen.\r\n\r\nFor at have succes i stillingen
      skal i f\xF8lge ideologien for Realisternes Parti. Hvis i mislykkes, risikerer
      i at blive afskediget af Statsministeren.\r\n\r\nKlik et sted p\xE5 sk\xE6rmen
      for at forts\xE6tte."
    trigger: 1
    delay: 0
  - position: {x: -165, y: 0}
    tutorialText: "P\xE5 h\xF8jre side af mappen vil i kunne se et scenarie, og p\xE5
      venstre side vil i kunne se et af jeres mulige svar. \n\nTryk p\xE5 m\xE6rkerne
      i toppen af venstre papir for at skifte svar."
    trigger: 2
    delay: 0
  - position: {x: -165, y: 0}
    tutorialText: "Alle understregede ord har en forklaringstekst, som kan ses ved
      at holde musen over ordet.\n\nSet musen over ordet \"beskrivelsen\" for at
      se forklaringen og g\xE5 videre."
    trigger: 4
    delay: 0
  - position: {x: -300, y: 0}
    tutorialText: "Hvis i p\xE5 noget tidspunkt bliver i tvivl om jeres partis ideologi,
      kan i trykke p\xE5 partiets logo nederst i venstre hj\xF8rne.\n\nTryk p\xE5
      ikonet for at g\xE5 videre"
    trigger: 5
    delay: 0
  - position: {x: 100, y: 0}
    tutorialText: "Her kan i se partiets holdninger og ideologi.\n\nTryk p\xE5 krydset
      for at lukke siden."
    trigger: 6
    delay: 0
  - position: {x: -165, y: -50}
    tutorialText: "N\xE5r i har fundet det svar som i mener passer til jeres partis
      holdning, kan i klikke Godkend. \n\nDette l\xE5ser jeres handling i scenariet."
    trigger: 3
    delay: 0
  - position: {x: -300, y: 0}
    tutorialText: "Efter hvert scenarie vil i se statsministerens reaktion p\xE5
      jeres handlinger. \n\nHvis i gentagne gange handler udenfor partiets ideologi,
      vil statsministeren tage jeres position fra jer.\n\nHvis i handler indenfor
      partiets m\xE5l og ideologi, stiger jeres popularitet, og i kan forblive i
      stillingen.\n\nTryk forts\xE6t for at g\xE5 videre til n\xE6ste scenarie.\n\nHeld
      og lykke!"
    trigger: 1
    delay: 5000
