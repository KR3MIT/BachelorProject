%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ae75645fe088644cb9e6f0114d9b8a2, type: 3}
  m_Name: QuestionStepExample
  m_EditorClassIdentifier: Assembly-CSharp::QuestionStep
  question: "I er blevet inviteret til et interview p\xE5 nationalt tv med DR for
    at diskutere Danmarks forsvar og mulige trusler fra andre lande. \n\nI skal v\xE6lge,
    hvilken handleplan i vil pr\xE6sentere for det danske folk."
  answers:
  - answerText: "I disse sv\xE6re tider har verden brug for sammenhold og samarbejde
      mere end nogensinde f\xF8r. \n\nDanmark skal g\xE5 forrest i fredfyldt kommunikation
      og konfliktbil\xE6ggelse p\xE5 det globale plan, samt have fokus p\xE5 at \xF8ge
      det globale samarbejde."
    viewpoint: 1
    explanations:
    - explanationText: "Jeg har lige set jeres interview, rigtig fint arbejde! \n\nDet
        med fredfyldt konfliktbel\xE6ggelse var specielt godt n\xE6vnt."
      viewpoint: 1
      image: {fileID: 21300000, guid: ce29367c2809db946a42c36d83f69cab, type: 3}
    - explanationText: "Jeg har lige set jeres interview, og det var bestemt ikke
        det bedste. \n\nDit svar ignorerer helt at Danmark burde styrke sin milit\xE6re
        magt, som vi gik til valg p\xE5. \n\nHusk det n\xE6ste gang!"
      viewpoint: 0
      image: {fileID: 21300000, guid: 2869103ee0c333e4fba3a4ba59d2ef1c, type: 3}
  - answerText: "Danmark skal f\xF8rst og fremmest v\xE6rne om egne interesser, og
      dette g\xE6lder ogs\xE5 for forsvaret. \n\nDanmark skal fors\xE6tte med at
      styrke sin egen magt p\xE5 den internationale scene uagtet krav eller normer
      p\xE5sat danskerne internationalt."
    viewpoint: 0
    explanations:
    - explanationText: "Jeg har lige set jeres interview, og det var bestemt ikke
        det bedste. \n\nJeres svar underspiller vores ambition om at \xF8ge Danmark
        internationale samarbejde, og har i stedet fokus p\xE5 forsvarets magt, hvilket
        ikke er vores partis fokus. \n\nHusk det n\xE6ste gang!"
      viewpoint: 1
      image: {fileID: 21300000, guid: 2869103ee0c333e4fba3a4ba59d2ef1c, type: 3}
    - explanationText: "Jeg har lige set jeres interview, rigtig fint arbejde! \n\nI
        fik kommunikeret vores \xF8nske om et st\xE6rkere og sikrere Danmark gennem
        et st\xE6rkt forsvar rigtig godt!"
      viewpoint: 0
      image: {fileID: 21300000, guid: ce29367c2809db946a42c36d83f69cab, type: 3}
  - answerText: "Mens Danmark aldrig skal ignorere forsvaret, s\xE5 er det ogs\xE5
      vigtigt at bibeholde fokus p\xE5 at forhandle med andre lande. \n\nInternationale
      aftaler er et vigtigt v\xE6rkt\xF8j til at bibeholde freden, men det danske
      forsvar skal altid v\xE6re kampdygtigt, hvis disse aftaler brydes af andre
      lande.\n"
    viewpoint: 2
    explanations:
    - explanationText: "Jeg har lige set jeres interview, og jeg har et par noter
        til jer. \n\nN\xE6ste gang m\xE5 i gerne have mere fokus p\xE5 fremmelsen
        det internationale samarbejde og interdependens, det er vores m\xE6rkesag!"
      viewpoint: 1
      image: {fileID: 21300000, guid: 2869103ee0c333e4fba3a4ba59d2ef1c, type: 3}
    - explanationText: "Jeg har lige set jeres interview, og jeg har et par noter
        til jer. \n\nN\xE6ste gang m\xE5 i gerne have mere fokus p\xE5 Danmarks milit\xE6re
        magt, og at vi har et m\xE5l om at forbedre den. \n\nHusk det n\xE6ste gang!"
      viewpoint: 0
      image: {fileID: 21300000, guid: 2869103ee0c333e4fba3a4ba59d2ef1c, type: 3}
